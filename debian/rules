#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
ifeq ($(filter amd64,$(DEB_HOST_ARCH)),amd64)
	dh_auto_configure -- -DECHOFLOW_CPU_TARGET=x86-64-v3 -DCMAKE_INSTALL_SYSCONFDIR=/etc
else
	dh_auto_configure -- -DECHOFLOW_CPU_TARGET=native -DCMAKE_INSTALL_SYSCONFDIR=/etc
endif
