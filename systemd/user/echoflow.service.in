[Unit]
Description=EchoFlow offline voice input service

[Service]
Type=simple
Environment=PATH=@CMAKE_INSTALL_FULL_BINDIR@:/usr/bin:/bin
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/echoflow-service
TimeoutStopSec=30
Restart=on-failure
