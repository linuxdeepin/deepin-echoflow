[Unit]
Description=EchoFlow tooltip UI host
Requisite=graphical-session.target
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/echoflow-ui
Restart=on-failure

[Install]
WantedBy=graphical-session.target
